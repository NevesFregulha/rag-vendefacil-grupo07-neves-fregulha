# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env (ja esta no .gitignore).

# Provedor do LLM usado pelo pipeline RAG e pelo LLM-as-judge da Etapa 4.
# "openrouter" (padrao), "groq" ou "anthropic".
LLM_PROVIDER=openrouter

# Chave de API da Groq (console.groq.com/keys), necessaria se LLM_PROVIDER=groq.
GROQ_API_KEY=

# Chave de API da Anthropic, necessaria apenas se LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Chave do OpenRouter (openrouter.ai/keys), necessaria se LLM_PROVIDER=openrouter.
# Atencao: saldo negativo na conta bloqueia ate os modelos gratuitos.
OPENROUTER_API_KEY=

# Endpoint do OpenRouter. So altere se estiver usando um proxy.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo usado para geracao estruturada e avaliacao (opcional - ja tem um
# padrao sensato para cada provedor em config.py).
# No OpenRouter, o modelo precisa suportar tool calling; confira o campo
# `supported_parameters` em https://openrouter.ai/api/v1/models.
LLM_MODEL=

# Numero de chunks recuperados por pergunta na busca hibrida (opcional).
RETRIEVAL_K=5

# Tentativas maximas de geracao estruturada em caso de falha de validacao (opcional).
MAX_GENERATION_ATTEMPTS=3
