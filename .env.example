# Chave de API da Anthropic, usada pelo LLM do pipeline RAG e pelo
# LLM-as-judge da Etapa 4.
ANTHROPIC_API_KEY=

# Modelo usado para geracao estruturada e avaliacao (opcional).
LLM_MODEL=claude-opus-5

# Numero de chunks recuperados por pergunta na busca hibrida (opcional).
RETRIEVAL_K=5

# Tentativas maximas de geracao estruturada em caso de falha de validacao (opcional).
MAX_GENERATION_ATTEMPTS=3