# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env (ja esta no .gitignore).

# Provedor do LLM usado pelo pipeline RAG e pelo LLM-as-judge da Etapa 4.
# "groq" (padrao, tem tier gratuito sem cartao) ou "anthropic".
LLM_PROVIDER=groq

# Chave de API da Groq (console.groq.com/keys), necessaria se LLM_PROVIDER=groq.
GROQ_API_KEY=

# Chave de API da Anthropic, necessaria apenas se LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Modelo usado para geracao estruturada e avaliacao (opcional - ja tem um
# padrao sensato para cada provedor em config.py).
LLM_MODEL=

# Numero de chunks recuperados por pergunta na busca hibrida (opcional).
RETRIEVAL_K=5

# Tentativas maximas de geracao estruturada em caso de falha de validacao (opcional).
MAX_GENERATION_ATTEMPTS=3
